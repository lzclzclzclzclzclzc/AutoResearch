{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Evidence": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "inference",
            "unverified",
            "failed",
            "negative"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "claim",
        "status"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "IssueReclassification": {
      "properties": {
        "from_category": {
          "enum": [
            "must_fix",
            "experimental_disagreement",
            "suggestion"
          ],
          "title": "From Category",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "from_category",
        "rationale",
        "evidence"
      ],
      "title": "IssueReclassification",
      "type": "object"
    }
  },
  "properties": {
    "issue_id": {
      "title": "Issue Id",
      "type": "string"
    },
    "category": {
      "enum": [
        "must_fix",
        "experimental_disagreement",
        "suggestion"
      ],
      "title": "Category",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "resolved": {
      "default": false,
      "title": "Resolved",
      "type": "boolean"
    },
    "resolution": {
      "default": "",
      "title": "Resolution",
      "type": "string"
    },
    "experiment_mapping": {
      "default": "",
      "title": "Experiment Mapping",
      "type": "string"
    },
    "reclassification": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssueReclassification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "issue_id",
    "category",
    "description"
  ],
  "title": "Issue",
  "type": "object"
}
