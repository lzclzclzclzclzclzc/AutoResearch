{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "part_id": {
      "minLength": 1,
      "title": "Part Id",
      "type": "string"
    },
    "target_role": {
      "title": "Target Role",
      "type": "string"
    },
    "instructions": {
      "minLength": 1,
      "title": "Instructions",
      "type": "string"
    },
    "input_refs": {
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    },
    "allowed_write_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Write Paths",
      "type": "array"
    },
    "depends_on": {
      "items": {
        "type": "string"
      },
      "title": "Depends On",
      "type": "array"
    }
  },
  "required": [
    "part_id",
    "target_role",
    "instructions",
    "output_schema",
    "allowed_write_paths"
  ],
  "title": "DecompositionPart",
  "type": "object"
}
