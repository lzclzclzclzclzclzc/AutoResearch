{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "arbitration_id": {
      "title": "Arbitration Id",
      "type": "string"
    },
    "snapshot_hash": {
      "title": "Snapshot Hash",
      "type": "string"
    },
    "content_markdown": {
      "minLength": 1,
      "title": "Content Markdown",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "unresolved_issue_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Issue Ids",
      "type": "array"
    },
    "action": {
      "const": "finish_scope",
      "title": "Action",
      "type": "string"
    },
    "line_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Line Id"
    },
    "existing_result_refs": {
      "items": {
        "type": "string"
      },
      "title": "Existing Result Refs",
      "type": "array"
    }
  },
  "required": [
    "arbitration_id",
    "snapshot_hash",
    "content_markdown",
    "rationale",
    "action"
  ],
  "title": "FinishScopeDecision",
  "type": "object"
}
