{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        }
      },
      "required": [
        "line_id",
        "objective"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "BossDecision": {
      "additionalProperties": false,
      "properties": {
        "content_markdown": {
          "title": "Content Markdown",
          "type": "string"
        },
        "action": {
          "enum": [
            "assign",
            "continue",
            "request_evidence",
            "change_direction",
            "finish_line",
            "finish_project",
            "report"
          ],
          "title": "Action",
          "type": "string"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/Assignment"
          },
          "title": "Assignments",
          "type": "array"
        },
        "memory_updates": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Memory Updates",
          "type": "array"
        },
        "request_report": {
          "default": true,
          "title": "Request Report",
          "type": "boolean"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "content_markdown",
        "action",
        "rationale"
      ],
      "title": "BossDecision",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "inference",
            "unverified",
            "failed",
            "negative"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "claim",
        "status"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "must_fix",
            "experimental_disagreement",
            "suggestion"
          ],
          "title": "Category",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        },
        "resolution": {
          "default": "",
          "title": "Resolution",
          "type": "string"
        },
        "experiment_mapping": {
          "default": "",
          "title": "Experiment Mapping",
          "type": "string"
        },
        "reclassification": {
          "anyOf": [
            {
              "$ref": "#/$defs/IssueReclassification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "issue_id",
        "category",
        "description"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueReclassification": {
      "additionalProperties": false,
      "properties": {
        "from_category": {
          "enum": [
            "must_fix",
            "experimental_disagreement",
            "suggestion"
          ],
          "title": "From Category",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "from_category",
        "rationale",
        "evidence"
      ],
      "title": "IssueReclassification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_markdown": {
      "title": "Content Markdown",
      "type": "string"
    },
    "ready_for_vote": {
      "title": "Ready For Vote",
      "type": "boolean"
    },
    "new_evidence": {
      "items": {
        "type": "string"
      },
      "title": "New Evidence",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "revised_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/BossDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "content_markdown",
    "ready_for_vote"
  ],
  "title": "BossReview",
  "type": "object"
}
