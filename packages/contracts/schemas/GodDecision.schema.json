  "description": "The serialized representation is the flat, discriminated action object.",
  "discriminator": {
    "mapping": {
      "decompose_task": "#/$defs/DecomposeTaskDecision",
      "finish_scope": "#/$defs/FinishScopeDecision",
      "needs_external_input": "#/$defs/NeedsExternalInputDecision",
      "repair_output": "#/$defs/RepairOutputDecision",
      "request_evidence": "#/$defs/RequestEvidenceDecision",
      "request_revision": "#/$defs/RequestRevisionDecision",
      "select_candidate": "#/$defs/SelectCandidateDecision"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SelectCandidateDecision"
    },
    {
      "$ref": "#/$defs/RepairOutputDecision"
    },
    {
      "$ref": "#/$defs/RequestRevisionDecision"
    },
    {
      "$ref": "#/$defs/RequestEvidenceDecision"
    },
    {
      "$ref": "#/$defs/DecomposeTaskDecision"
    },
    {
      "$ref": "#/$defs/FinishScopeDecision"
    },
    {
      "$ref": "#/$defs/NeedsExternalInputDecision"
    }
  ],
  "title": "GodDecision"
