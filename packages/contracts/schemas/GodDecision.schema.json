        "why_unavailable": {
          "minLength": 1,
          "title": "Why Unavailable",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "dependency_line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Line Ids",
          "type": "array"
