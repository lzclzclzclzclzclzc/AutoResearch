            "type": "string"
          },
          "title": "Unresolved Issue Ids",
          "type": "array"
        },
        "action": {
          "const": "finish_scope",
          "title": "Action",
          "type": "string"
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Id"
        },
        "existing_result_refs": {
          "items": {
            "type": "string"
          },
          "title": "Existing Result Refs",
          "type": "array"
        }
      },
      "required": [
        "arbitration_id",
        "snapshot_hash",
        "content_markdown",
        "rationale",
        "action"
      ],
      "title": "FinishScopeDecision",
      "type": "object"
    },
    "MergePlan": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "json_fields",
            "markdown_sections",
            "files",
            "file_fragments"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Order",
          "type": "array"
        },
        "base_output": {
          "additionalProperties": true,
          "title": "Base Output",
          "type": "object"
        }
      },
      "required": [
        "strategy",
        "order"
      ],
      "title": "MergePlan",
      "type": "object"
    },
    "NeedsExternalInputDecision": {
