{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "claim": {
      "title": "Claim",
      "type": "string"
    },
    "status": {
      "enum": [
        "observed",
        "inference",
        "unverified",
        "failed",
        "negative"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "claim",
    "status"
  ],
  "title": "Evidence",
  "type": "object"
}
