{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "content_markdown": {
      "minLength": 1,
      "title": "Content Markdown",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "scientific_observation": {
      "enum": [
        "improvement",
        "no_improvement",
        "negative",
        "inconclusive",
        "execution_failed"
      ],
      "title": "Scientific Observation",
      "type": "string"
    }
  },
  "required": [
    "content_markdown",
    "passed",
    "scientific_observation"
  ],
  "title": "Verification",
  "type": "object"
}
