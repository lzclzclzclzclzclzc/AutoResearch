{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "arbitration_id": {
      "title": "Arbitration Id",
      "type": "string"
    },
    "snapshot_hash": {
      "title": "Snapshot Hash",
      "type": "string"
    },
    "content_markdown": {
      "minLength": 1,
      "title": "Content Markdown",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "unresolved_issue_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Issue Ids",
      "type": "array"
    },
    "action": {
      "const": "select_candidate",
      "title": "Action",
      "type": "string"
    },
    "selected_candidate_id": {
      "title": "Selected Candidate Id",
      "type": "string"
    },
    "minority_views": {
      "items": {
        "type": "string"
      },
      "title": "Minority Views",
      "type": "array"
    }
  },
  "required": [
    "arbitration_id",
    "snapshot_hash",
    "content_markdown",
    "rationale",
    "action",
    "selected_candidate_id"
  ],
  "title": "SelectCandidateDecision",
  "type": "object"
}
