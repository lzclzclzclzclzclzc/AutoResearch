{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Evidence": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "inference",
            "unverified",
            "failed",
            "negative"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "claim",
        "status"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Issue": {
      "properties": {
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "must_fix",
            "experimental_disagreement",
            "suggestion"
          ],
          "title": "Category",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        },
        "resolution": {
          "default": "",
          "title": "Resolution",
          "type": "string"
        },
        "experiment_mapping": {
          "default": "",
          "title": "Experiment Mapping",
          "type": "string"
        },
        "reclassification": {
          "anyOf": [
            {
              "$ref": "#/$defs/IssueReclassification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "acceptance_stage": {
          "default": "design",
          "enum": [
            "design",
            "execution"
          ],
          "title": "Acceptance Stage",
          "type": "string"
        },
        "stage_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/IssueStageReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "issue_id",
        "category",
        "description"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueReclassification": {
      "properties": {
        "from_category": {
          "enum": [
            "must_fix",
            "experimental_disagreement",
            "suggestion"
          ],
          "title": "From Category",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "from_category",
        "rationale",
        "evidence"
      ],
      "title": "IssueReclassification",
      "type": "object"
    },
    "IssueStageReview": {
      "properties": {
        "from_stage": {
          "enum": [
            "design",
            "execution"
          ],
          "title": "From Stage",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "from_stage",
        "rationale",
        "evidence"
      ],
      "title": "IssueStageReview",
      "type": "object"
    }
  },
  "properties": {
    "discussion_protocol": {
      "default": 1,
      "enum": [
        1,
        2
      ],
      "title": "Discussion Protocol",
      "type": "integer"
    },
    "content_markdown": {
      "default": "",
      "title": "Content Markdown",
      "type": "string"
    },
    "spec_id": {
      "title": "Spec Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "hypothesis": {
      "title": "Hypothesis",
      "type": "string"
    },
    "fixed": {
      "additionalProperties": true,
      "title": "Fixed",
      "type": "object"
    },
    "allowed_adjustments": {
      "additionalProperties": true,
      "title": "Allowed Adjustments",
      "type": "object"
    },
    "baseline": {
      "title": "Baseline",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "metrics": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "design": {
      "additionalProperties": true,
      "title": "Design",
      "type": "object"
    },
    "monitoring": {
      "additionalProperties": true,
      "title": "Monitoring",
      "type": "object"
    },
    "completion_criteria": {
      "title": "Completion Criteria",
      "type": "string"
    },
    "early_stop_rules": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Early Stop Rules",
      "type": "array"
    },
    "issues": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/Issue"
          },
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Issues",
      "type": "array"
    },
    "deadline_at": {
      "title": "Deadline At",
      "type": "string"
    }
  },
  "required": [
    "spec_id",
    "version",
    "question",
    "hypothesis",
    "fixed",
    "baseline",
    "data",
    "metrics",
    "design",
    "monitoring",
    "completion_criteria",
    "deadline_at"
  ],
  "title": "ExperimentSpec",
  "type": "object"
}
