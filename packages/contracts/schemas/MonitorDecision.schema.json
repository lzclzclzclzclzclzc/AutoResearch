{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_markdown": {
      "title": "Content Markdown",
      "type": "string"
    },
    "request_early_stop": {
      "title": "Request Early Stop",
      "type": "boolean"
    },
    "rule_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Id"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "evidence_log_hash": {
      "title": "Evidence Log Hash",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "content_markdown",
    "request_early_stop",
    "rationale",
    "evidence_log_hash"
  ],
  "title": "MonitorDecision",
  "type": "object"
}
