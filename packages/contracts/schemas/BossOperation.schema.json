{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "operation": {
      "enum": [
        "research",
        "change_direction",
        "finish_line",
        "report"
      ],
      "title": "Operation",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    },
    "objective": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objective"
    }
  },
  "required": [
    "operation"
  ],
  "title": "BossOperation",
  "type": "object"
}
