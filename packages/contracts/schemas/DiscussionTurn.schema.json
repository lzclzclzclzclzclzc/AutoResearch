{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EndVoteRequest": {
      "properties": {
        "final_output": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Final Output",
          "type": "object"
        }
      },
      "required": [
        "final_output"
      ],
      "title": "EndVoteRequest",
      "type": "object"
    },
    "OrdinaryVoteRequest": {
      "properties": {
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "question",
        "options"
      ],
      "title": "OrdinaryVoteRequest",
      "type": "object"
    }
  },
  "description": "A normal utterance, optionally followed by a member-initiated vote.",
  "properties": {
    "content_markdown": {
      "title": "Content Markdown",
      "type": "string"
    },
    "ordinary_vote": {
      "anyOf": [
        {
          "$ref": "#/$defs/OrdinaryVoteRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "end_vote": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndVoteRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "content_markdown"
  ],
  "title": "DiscussionTurn",
  "type": "object"
}
