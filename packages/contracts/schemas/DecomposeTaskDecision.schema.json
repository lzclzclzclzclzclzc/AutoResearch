{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DecompositionPart": {
      "properties": {
        "part_id": {
          "minLength": 1,
          "title": "Part Id",
          "type": "string"
        },
        "target_role": {
          "title": "Target Role",
          "type": "string"
        },
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "allowed_write_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Write Paths",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "part_id",
        "target_role",
        "instructions",
        "output_schema",
        "allowed_write_paths"
      ],
      "title": "DecompositionPart",
      "type": "object"
    },
    "DecompositionPlan": {
      "properties": {
        "target_schema_hash": {
          "title": "Target Schema Hash",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/DecompositionPart"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        },
        "merge_plan": {
          "$ref": "#/$defs/MergePlan"
        },
        "invariants": {
          "additionalProperties": true,
          "title": "Invariants",
          "type": "object"
        },
        "acceptance_checks": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Checks",
          "type": "array"
        }
      },
      "required": [
        "target_schema_hash",
        "parts",
        "merge_plan",
        "acceptance_checks"
      ],
      "title": "DecompositionPlan",
      "type": "object"
    },
    "MergePlan": {
      "properties": {
        "strategy": {
          "enum": [
            "json_fields",
            "markdown_sections",
            "files",
            "file_fragments"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Order",
          "type": "array"
        },
        "base_output": {
          "additionalProperties": true,
          "title": "Base Output",
          "type": "object"
        }
      },
      "required": [
        "strategy",
        "order"
      ],
      "title": "MergePlan",
      "type": "object"
    }
  },
  "properties": {
    "arbitration_id": {
      "title": "Arbitration Id",
      "type": "string"
    },
    "snapshot_hash": {
      "title": "Snapshot Hash",
      "type": "string"
    },
    "content_markdown": {
      "minLength": 1,
      "title": "Content Markdown",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "unresolved_issue_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Issue Ids",
      "type": "array"
    },
    "action": {
      "const": "decompose_task",
      "title": "Action",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/DecompositionPlan"
    }
  },
  "required": [
    "arbitration_id",
    "snapshot_hash",
    "content_markdown",
    "rationale",
    "action",
    "plan"
  ],
  "title": "DecomposeTaskDecision",
  "type": "object"
}
