{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "strategy": {
      "enum": [
        "json_fields",
        "markdown_sections",
        "files",
        "file_fragments"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "order": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Order",
      "type": "array"
    },
    "base_output": {
      "additionalProperties": true,
      "title": "Base Output",
      "type": "object"
    }
  },
  "required": [
    "strategy",
    "order"
  ],
  "title": "MergePlan",
  "type": "object"
}
