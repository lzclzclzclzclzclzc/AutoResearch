{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Assignment": {
      "properties": {
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        }
      },
      "required": [
        "line_id",
        "objective"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "BossDecision": {
      "properties": {
        "content_markdown": {
          "title": "Content Markdown",
          "type": "string"
        },
        "action": {
          "enum": [
            "assign",
            "continue",
            "request_evidence",
            "change_direction",
            "finish_line",
            "finish_project",
            "report"
          ],
          "title": "Action",
          "type": "string"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/Assignment"
          },
          "title": "Assignments",
          "type": "array"
        },
        "memory_updates": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Memory Updates",
          "type": "array"
        },
        "request_report": {
          "default": true,
          "title": "Request Report",
          "type": "boolean"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "content_markdown",
        "action",
        "rationale"
      ],
      "title": "BossDecision",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "inference",
            "unverified",
            "failed",
            "negative"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "claim",
        "status"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "properties": {
    "content_markdown": {
      "title": "Content Markdown",
      "type": "string"
    },
    "candidate": {
      "$ref": "#/$defs/BossDecision"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "content_markdown",
    "candidate"
  ],
  "title": "BossProposal",
  "type": "object"
}
